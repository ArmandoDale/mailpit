# Configurazione di riferimento delle istanze IPZS di Mailpit
#
# Ogni voce di questo file corrisponde a un'affermazione del SID: modificarla
# significa rendere falso il documento, non solo cambiare un comportamento.
# La colonna di riferimento e' indicata accanto a ciascun blocco.
#
# I valori marcati [AMBIENTE] cambiano per ambiente e vanno valorizzati in fase
# di realizzazione. Tutti gli altri sono vincolati.

# --- Punti di ascolto -------------------------------------------------------
# SID par. 2.3, T-02. L'ascolto e' su tutte le interfacce del pod: la
# restrizione delle sorgenti e' realizzata dalle regole di rete, non qui.
MP_SMTP_BIND_ADDR=0.0.0.0:1025
MP_UI_BIND_ADDR=0.0.0.0:8025

# --- Contenimento: nessun percorso di uscita --------------------------------
# SID RS-01. Il prodotto ha due meccanismi di uscita distinti - il rilascio
# manuale del singolo messaggio e l'inoltro automatico dell'intero flusso - e
# nessuno dei due e' configurato. Le righe sono lasciate esplicite e vuote
# perche' la loro assenza e' un requisito, non una dimenticanza: un valore qui
# basta a violare lo scopo dell'intera soluzione.
#
# ATTENZIONE: ciascun meccanismo si attiva per DUE vie indipendenti, il file
# YAML e le variabili d'ambiente. Per il rilascio basta MP_SMTP_RELAY_HOST:
# config/validators.go:87 accetta la configurazione appena l'host e' valorizzato
# e imposta ReleaseEnabled, senza che alcun file esista. Vincolare il solo
# MP_SMTP_RELAY_CONFIG lascerebbe quindi aperta la seconda via.

# Rilascio manuale: file di configurazione
MP_SMTP_RELAY_CONFIG=
# Rilascio manuale: configurazione per variabili d'ambiente
MP_SMTP_RELAY_HOST=
MP_SMTP_RELAY_PORT=
MP_SMTP_RELAY_USERNAME=
MP_SMTP_RELAY_PASSWORD=
MP_SMTP_RELAY_SECRET=
MP_SMTP_RELAY_AUTH=
MP_SMTP_RELAY_TLS=
MP_SMTP_RELAY_STARTTLS=
MP_SMTP_RELAY_ALLOW_INSECURE=
MP_SMTP_RELAY_RETURN_PATH=
MP_SMTP_RELAY_OVERRIDE_FROM=
MP_SMTP_RELAY_ALLOWED_RECIPIENTS=
MP_SMTP_RELAY_BLOCKED_RECIPIENTS=
MP_SMTP_RELAY_PRESERVE_MESSAGE_IDS=
MP_SMTP_RELAY_FWD_SMTP_ERRORS=
# Rilascio automatico di tutti i messaggi, o di quelli corrispondenti
MP_SMTP_RELAY_ALL=
MP_SMTP_RELAY_MATCHING=

# Inoltro automatico dell'intero flusso: file di configurazione
MP_SMTP_FORWARD_CONFIG=
# Inoltro automatico: configurazione per variabili d'ambiente
MP_SMTP_FORWARD_HOST=
MP_SMTP_FORWARD_PORT=
MP_SMTP_FORWARD_TO=
MP_SMTP_FORWARD_USERNAME=
MP_SMTP_FORWARD_PASSWORD=
MP_SMTP_FORWARD_SECRET=
MP_SMTP_FORWARD_AUTH=
MP_SMTP_FORWARD_TLS=
MP_SMTP_FORWARD_STARTTLS=
MP_SMTP_FORWARD_ALLOW_INSECURE=
MP_SMTP_FORWARD_RETURN_PATH=
MP_SMTP_FORWARD_OVERRIDE_FROM=
MP_SMTP_FORWARD_FWD_SMTP_ERRORS=

# --- Contenimento del traffico verso le destinazioni dei messaggi -----------
# SID RS-11. Il traffico ha due origini distinte, e la distinzione conta perche'
# solo la prima e' governata dalla NetworkPolicy in uscita del pod:
#
#   dal SERVIZIO   verifica dei link (internal/linkcheck) e generazione degli
#                  screenshot (server/handlers/proxy.go): il processo Mailpit
#                  contatta le destinazioni citate nel messaggio. Non sono
#                  disattivabili e restano nell'interfaccia: le impedisce la
#                  NetworkPolicy, che nega al pod ogni traffico in uscita
#                  salvo la risoluzione dei nomi.
#   dal BROWSER    risorse remote referenziate nel messaggio (fogli di stile,
#                  caratteri, immagini). L'anteprima e' un iframe srcdoc
#                  (MessageItem.vue), quindi a scaricarle e' la postazione di
#                  chi apre il messaggio, non il pod. La NetworkPolicy non le
#                  tocca: le governa la Content Security Policy della pagina.
#
# MP_BLOCK_REMOTE_CSS_AND_FONTS restringe la CSP a 'self' per style-src e
# font-src (config/config.go:298-308). Resta img-src * data: blob:, che il
# prodotto non consente di restringere: le immagini remote di un messaggio
# vengono quindi caricate dal browser. E' un limite dichiarato nel SID, non
# coperto da questa configurazione.
MP_BLOCK_REMOTE_CSS_AND_FONTS=true
MP_ALLOW_INTERNAL_HTTP_REQUESTS=
MP_ALLOW_UNTRUSTED_TLS=

# --- Accesso ----------------------------------------------------------------
# SID RS-04. Autenticazione su interfaccia e API con file htpasswd.
# Il file e' distribuito tramite Secret e non versionato. [AMBIENTE]
MP_UI_AUTH_FILE=/etc/mailpit/ui-auth

# Le due voci seguenti disattivano l'autenticazione dove essa e' richiesta e
# devono restare vuote: la prima apre l'API di invio a chiunque raggiunga la
# porta, la seconda fa accettare al servizio SMTP qualunque credenziale.
MP_SEND_API_AUTH_ACCEPT_ANY=
MP_SMTP_AUTH_ACCEPT_ANY=

# Autenticazione sul servizio SMTP: non attiva per impostazione predefinita
# (SID par. 4.2.2.1). Si valorizza solo per gli ambienti che ne facciano
# richiesta motivata, insieme a MP_SMTP_AUTH_FILE. [AMBIENTE]
MP_SMTP_AUTH_FILE=

# TLS: la terminazione avviene sull'Ingress del cluster (SID RS-05), quindi
# il servizio non espone TLS proprio. Se si scegliesse di terminarlo
# sull'istanza, valorizzare le due voci seguenti.
MP_UI_TLS_CERT=
MP_UI_TLS_KEY=

# --- Conservazione ----------------------------------------------------------
# SID RF-13 e par. 4.2.5.2. Entrambe le soglie sono necessarie: senza MP_MAX_AGE
# la sola politica attiva sarebbe quella per numerosita', e il requisito
# risulterebbe soddisfatto a meta'. Il valore predefinito del prodotto per
# MP_MAX_MESSAGES e' 500, inadeguato al modello a istanza condivisa.
MP_MAX_MESSAGES=100000
MP_MAX_AGE=7d

# --- Regole di etichettatura ------------------------------------------------
# SID par. 4.2.2.2 e T-03. Il file e' la copia leggibile e versionabile delle
# regole, riscritta dal servizio a ogni modifica. Sta sul volume persistente,
# accanto al database, perche' la riscrittura crea un file temporaneo nella
# stessa directory e la richiede scrivibile: non puo' quindi essere fornito
# tramite ConfigMap, montata in sola lettura, dove la scrittura fallirebbe
# lasciandone traccia solo nel log. File e database sono protetti dal backup
# del volume (T-08).
# Il file deve esistere all'avvio, anche privo di regole: se manca, il servizio
# non parte. Su volume nuovo lo crea un initContainer, prima del servizio:
#   test -f /data/tag-filters.yaml || printf 'filters: []\n' > /data/tag-filters.yaml
MP_TAGS_CONFIG=/data/tag-filters.yaml

# --- Persistenza ------------------------------------------------------------
# SID par. 4.2.5 e T-03. Volume persistente dell'istanza, montato su /data,
# distinto per ambiente e soggetto a backup (T-08).
MP_DATABASE=/data/mailpit.db

# --- Funzionalita' non attive -----------------------------------------------
# SID RS-12 (webhook), RS-13 (POP3). Sono gia' disattivate per impostazione
# predefinita: sono dichiarate qui perche' un default non e' un controllo, ed
# e' un controllo solo finche' nessuno lo cambia.
MP_WEBHOOK_URL=
MP_POP3_BIND_ADDR=
MP_POP3_AUTH_FILE=
MP_ENABLE_CHAOS=
MP_ENABLE_SPAMASSASSIN=

# --- Logging ----------------------------------------------------------------
# SID RS-10. Livello predefinito: il livello verboso registra
# l'oggetto dei messaggi e si attiva solo per diagnosi, temporaneamente.
MP_VERBOSE=
MP_QUIET=

# --- Etichetta dell'ambiente ------------------------------------------------
# Compare nell'interfaccia e riduce il rischio di scambiare un ambiente per
# un altro. [AMBIENTE]
MP_LABEL=Ambiente di test
