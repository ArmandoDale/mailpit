# Configurazione di riferimento delle istanze IPZS di Mailpit
#
# Ogni voce di questo file corrisponde a un'affermazione del SID: modificarla
# significa rendere falso il documento, non solo cambiare un comportamento.
# La colonna di riferimento e' indicata accanto a ciascun blocco.
#
# I valori marcati [AMBIENTE] cambiano per ambiente e vanno valorizzati in fase
# di realizzazione. Tutti gli altri sono vincolati.

# --- Punti di ascolto -------------------------------------------------------
# SID par. 4.4.2.1.3. L'ascolto e' su tutte le interfacce della macchina:
# la restrizione delle sorgenti e' realizzata dalle regole firewall, non qui.
MP_SMTP_BIND_ADDR=0.0.0.0:1025
MP_UI_BIND_ADDR=0.0.0.0:8025

# --- Contenimento: nessun percorso di uscita --------------------------------
# SID RS-01. Il prodotto ha due meccanismi di uscita distinti e nessuno dei due
# e' configurato. Le righe sono lasciate esplicite e vuote perche' la loro
# assenza e' un requisito, non una dimenticanza: un valore qui basta a violare
# lo scopo dell'intera soluzione.
MP_SMTP_RELAY_CONFIG=
MP_SMTP_RELAY_ALL=
MP_SMTP_RELAY_MATCHING=
MP_SMTP_FORWARD_CONFIG=

# --- Contenimento: nessun traffico HTTP in uscita ---------------------------
# SID RS-12. Verifica dei link e screenshot non sono disattivabili e restano
# nell'interfaccia. Queste due voci coprono cio' che si puo' governare:
# il recupero automatico di risorse remote all'apertura di un messaggio, che
# per impostazione predefinita del prodotto e' ATTIVO, e l'accesso alle
# destinazioni interne, che per impostazione predefinita e' gia' negato.
# Il resto e' impedito dal blocco dell'egress sulle regole di rete.
MP_BLOCK_REMOTE_CSS_AND_FONTS=true
MP_ALLOW_INTERNAL_HTTP_REQUESTS=
MP_ALLOW_UNTRUSTED_TLS=

# --- Accesso ----------------------------------------------------------------
# SID RS-05. Autenticazione su interfaccia e API con file htpasswd.
# Il file e' distribuito tramite Secret e non versionato. [AMBIENTE]
MP_UI_AUTH_FILE=/etc/mailpit/ui-auth

# TLS: la terminazione avviene sul load balancer interno (SID RS-06), quindi
# il servizio non espone TLS proprio. Se la topologia adottata prevedesse la
# terminazione sull'istanza, valorizzare le due voci seguenti.
MP_UI_TLS_CERT=
MP_UI_TLS_KEY=

# --- Conservazione ----------------------------------------------------------
# SID RF-13 e par. 4.2.5.2. Entrambe le soglie sono necessarie: senza MP_MAX_AGE
# la sola politica attiva sarebbe quella per numerosita', e il requisito
# risulterebbe soddisfatto a meta'. Il valore predefinito del prodotto per
# MP_MAX_MESSAGES e' 500, inadeguato al modello a istanza condivisa.
MP_MAX_MESSAGES=100000
MP_MAX_AGE=7d

# --- Regole di etichettatura ------------------------------------------------
# SID par. 4.2.2.2. Il file e' la copia versionabile delle regole: senza questa
# voce le regole esisterebbero solo nel database, che non e' oggetto di
# ripristino, e un'istanza ricostruita accetterebbe i messaggi senza
# etichettarli. Il file deve essere scrivibile dall'utente del servizio.
MP_TAGS_CONFIG=/etc/mailpit/tag-filters.yaml

# --- Persistenza ------------------------------------------------------------
# SID par. 4.2.5. Storage dati dedicato, distinto per istanza.
MP_DATABASE=/var/lib/mailpit/mailpit.db

# --- Funzionalita' non attive -----------------------------------------------
# SID RS-13 (webhook), RS-14 (POP3). Sono gia' disattivate per impostazione
# predefinita: sono dichiarate qui perche' un default non e' un controllo, ed
# e' un controllo solo finche' nessuno lo cambia.
MP_WEBHOOK_URL=
MP_POP3_BIND_ADDR=
MP_POP3_AUTH_FILE=
MP_ENABLE_CHAOS=
MP_ENABLE_SPAMASSASSIN=

# --- Logging ----------------------------------------------------------------
# SID RS-11 e par. 4.4.2.1.7. Livello predefinito: il livello verboso registra
# l'oggetto dei messaggi e si attiva solo per diagnosi, temporaneamente.
MP_VERBOSE=
MP_QUIET=

# --- Etichetta dell'ambiente ------------------------------------------------
# Compare nell'interfaccia e riduce il rischio di scambiare un ambiente per
# un altro. [AMBIENTE]
MP_LABEL=Ambiente di test
